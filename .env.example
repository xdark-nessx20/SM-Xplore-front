# Copia este archivo como `.env` y ajusta los valores según tu entorno.
# Solo las variables con prefijo VITE_ quedan expuestas al código del cliente.

# Prefijo base de la API de SM-Xplore (backend Spring Boot).
# En desarrollo `/api/v1` se sirve a través del proxy de Vite hacia
# BACKEND_URL (por defecto http://localhost:8080), definido en vite.config.ts.
VITE_API_URL=/api/v1

# Puerto base del backend para el proxy de desarrollo de Vite.
# Descomenta si tu backend corre en otro puerto.
# BACKEND_URL=http://localhost:8080
